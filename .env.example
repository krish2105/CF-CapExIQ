# CapExIQ Environment Variables Template

# API Key for AI Advisory Explanations (Server-side Route Handler only)
# IMPORTANT: Never use NEXT_PUBLIC_ prefix for secrets!
# Works with OpenAI (sk-proj-...) or any OpenAI-compatible provider (e.g. NVIDIA NIM: nvapi-...)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Optional: override the API base URL to use a non-OpenAI OpenAI-compatible provider
# e.g. NVIDIA NIM: https://integrate.api.nvidia.com/v1
OPENAI_BASE_URL=""

# Model Environment Configuration
# Default is gpt-4o for OpenAI; use e.g. "openai/gpt-oss-120b" for NVIDIA NIM
OPENAI_MODEL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session signing key for the login system (HMAC-SHA256).
# REQUIRED in production — the app refuses to sign sessions without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Embedding model used to build the RAG knowledge base.
OPENAI_EMBEDDING_MODEL="nvidia/nv-embedqa-e5-v5"

# Optional: replace the seeded executive directory entirely (JSON array).
# Do this for any deployment that is not a local academic demo.
CAPEXIQ_USERS=""

# ---------------------------------------------------------------- backups
# Off-box snapshot destination. Without this, backups exist only on the same
# disk as the database, which is a rollback point rather than a real backup.
#   file:///mnt/backup-volume                       mounted volume / NAS
#   s3://bucket/prefix?region=eu-west-1             S3 or S3-compatible
#   https://acct.blob.core.windows.net/c?<sas>      Azure Blob / presigned PUT
CAPEXIQ_BACKUP_REMOTE=""

# Credentials for an s3: destination only.
CAPEXIQ_S3_ACCESS_KEY_ID=""
CAPEXIQ_S3_SECRET_ACCESS_KEY=""
# Optional: S3-compatible endpoint (MinIO, R2, Wasabi).
CAPEXIQ_S3_ENDPOINT=""

# Outer bound on outbound hosts. Every other allowlist entry is derived from
# the variable that names it, so a poisoned OPENAI_BASE_URL or
# CAPEXIQ_BACKUP_REMOTE would otherwise authorise itself. Intersection, not a
# grant: a host must be both derived and pinned. Unset = derive-only.
CAPEXIQ_EGRESS_ALLOWLIST=""

# Where local snapshots are written. Defaults to .data/backups
CAPEXIQ_BACKUP_DIR=""
