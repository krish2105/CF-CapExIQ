# CapExIQ Environment Variables Template
#
# GRACEFUL DEGRADATION (important)
# --------------------------------
# Every route under /api/ai/ works with NO environment configuration at all.
# When OPENAI_API_KEY is absent — or the model call times out, errors, or
# returns output that fails schema validation — each route returns HTTP 200
# with a deterministic advisory response generated from the pre-computed
# figures of the finance engine. It never returns a 500 for a missing key.
#
# Every AI response carries three provenance fields so the UI can label it:
#   isFallback     : boolean
#   source         : "model" | "deterministic"
#   fallbackReason : "none" | "no-api-key" | "model-error" | "invalid-model-output"
#
# The application is therefore fully demonstrable without any API key. The
# deterministic path is the default, not an error path.

# API Key for AI Advisory Explanations (Server-side Route Handler only)
# IMPORTANT: Never use NEXT_PUBLIC_ prefix for secrets!
# Works with OpenAI (sk-proj-...) or any OpenAI-compatible provider (e.g. NVIDIA NIM: nvapi-...)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Optional: override the API base URL to use a non-OpenAI OpenAI-compatible provider
# e.g. NVIDIA NIM: https://integrate.api.nvidia.com/v1
OPENAI_BASE_URL=""

# Model Environment Configuration
# Default is gpt-4o for OpenAI; use e.g. "openai/gpt-oss-120b" for NVIDIA NIM
OPENAI_MODEL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session signing key for the login system (HMAC-SHA256).
# REQUIRED in production — the app refuses to sign sessions without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Embedding model used to build the RAG knowledge base.
OPENAI_EMBEDDING_MODEL="nvidia/nv-embedqa-e5-v5"

# Optional: replace the seeded executive directory entirely (JSON array).
# Do this for any deployment that is not a local academic demo.
CAPEXIQ_USERS=""
